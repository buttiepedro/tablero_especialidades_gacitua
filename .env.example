# Copiá este archivo a .env y completá los valores antes de arrancar

# --- Backend ---
ADMIN_USER=admin
ADMIN_PASSWORD=changeme
SECRET_KEY=replace-with-a-long-random-secret

# --- MongoDB ---
# Mongo externo con autenticación (recomendado en producción):
# MONGO_URL=mongodb://admin:password@<host>:27017/tablero?authSource=admin

# Si no se define MONGO_URL, el backend usa mongodb://mongo:27017/tablero
# En ese caso levantá el mongo local con:  docker compose --profile local up

# --- Frontend ---
# URL pública del backend accesible desde el navegador del cliente.
# En local con docker compose: http://localhost:5000
# En producción: la URL pública del servicio backend (ej. https://api.tudominio.com)
API_URL=http://localhost:5000
