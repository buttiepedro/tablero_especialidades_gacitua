# Copiá este archivo a .env y completá los valores antes de arrancar

# --- Backend ---
ADMIN_USER=admin
ADMIN_PASSWORD=changeme
SECRET_KEY=replace-with-a-long-random-secret

# SQLite local (por defecto):
DATABASE_URL=sqlite:///data/especialidades.db

# PostgreSQL (descomentar y completar si usás Postgres):
# DATABASE_URL=postgresql://user:password@host:5432/tablero

# Schema de Postgres donde se crean las tablas (opcional, por defecto usa "public"):
# DB_SCHEMA=tablero

# --- Frontend ---
# URL pública del backend accesible desde el navegador del cliente.
# En local con docker compose: http://localhost:5000
# En producción: la URL pública del servicio backend (ej. https://api.tudominio.com)
API_URL=http://localhost:5000
